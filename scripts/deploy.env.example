# 复制为 scripts/deploy.env 后按服务器实际情况修改（deploy.env 不提交到 git）。

# 网站目录（nginx 的 root）
WEB_ROOT=/www/wwwroot/sanguosha

# 大厅进程实际加载 dist/cli.cjs 的目录。
# 如果大厅直接跑在网站目录里，留空即可（网站目录里的文件已经更新）。
# 用 `ps -ef | grep cli.cjs` 和 `readlink /proc/<pid>/cwd` 确认真实路径。
LOBBY_DIST_TARGET=

# 重启大厅的命令，注意用引号包住整条命令。
# 留空则只同步文件、不重启（需要手动重启）。
# 宝塔 Node 项目 / pm2:
# LOBBY_RESTART_CMD="pm2 restart noname-lobby"
# systemd:
# LOBBY_RESTART_CMD="systemctl restart noname-lobby"
LOBBY_RESTART_CMD=
